{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@primq/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@primq/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@primq/hooks": [
        "../../packages/hooks/src/index.ts"
      ],
      "@primq/hooks/*": [
        "../../packages/hooks/src/*"
      ],
      "@primq/api": [
        "../../packages/api/src/index.ts"
      ],
      "@primq/api/*": [
        "../../packages/api/src/*"
      ],
      "@primq/types": [
        "../../packages/types/src/index.ts"
      ],
      "@primq/types/*": [
        "../../packages/types/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}